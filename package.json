{
  "name": "cc-jsonl-monitor",
  "version": "0.3.0",
  "private": true,
  "description": "Local Claude Code JSONL file-tree viewer",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit -p tsconfig.json && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test:e2e": "playwright test",
    "build:extension": "tsc --noEmit -p tsconfig.json && vite build --config vite.extension.config.ts --mode extension",
    "package:extension": "npm run build:extension && powershell -NoProfile -File scripts/package-extension.ps1",
    "test:extension": "playwright test --config playwright.extension.config.ts"
  },
  "dependencies": {
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
